    <rdfs:label xml:lang="vi">Bệnh lý ở cá</rdfs:label>
    <rdfs:comment xml:lang="vi">Trạng thái bất thường về hình thái, giải phẫu hoặc chức năng sinh lý do tác nhân mầm bệnh hoặc suy thoái môi trường.</rdfs:comment>
  </rdf:Description>
