    <rdfs:label xml:lang="en">has treatment</rdfs:label>
    <rdfs:label xml:lang="vi">có biện pháp điều trị</rdfs:label>
    <rdfs:comment xml:lang="vi">Liên kết bệnh với phác đồ thuốc/hóa chất xử lý.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#hasWaterCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <rdfs:label xml:lang="en">has water condition</rdfs:label>
    <rdfs:label xml:lang="vi">có điều kiện nước</rdfs:label>
    <rdfs:comment xml:lang="vi">Liên kết ca bệnh với tập hợp số liệu chất lượng nước ao đo đạc tại thời điểm kiểm tra.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf15765f0764d4050bbba8d3fc3216c47">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6eb33a52f7dc4689a1423b958ad5ac84">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/fish-disease-ontology#hasTreatment"/>
    <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#AntibioticTreatment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Treatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Treatment</rdfs:label>
    <rdfs:label xml:lang="vi">Biện pháp điều trị</rdfs:label>
    <rdfs:comment xml:lang="vi">Phác đồ can thiệp dùng thuốc kháng sinh, sát trùng hoặc thảo dược theo quy định Bộ NN&amp;PTNT.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#pHValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
