    <rdfs:label xml:lang="en">pH value</rdfs:label>
    <rdfs:label xml:lang="vi">giá trị pH</rdfs:label>
    <rdfs:comment xml:lang="vi">Độ pH của nước ao (Khoảng thích hợp: 6.5 - 8.5; &lt;6.0 làm cá dễ tổn thương biểu bì).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N302574894f784e92ae45e90304db17d0">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Enteric_Septicemia_Catfish">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#BacterialDisease"/>
    <rdfs:subClassOf rdf:nodeID="Nbccc51cbedec476d9108e2aaefe8ad59"/>
    <rdfs:subClassOf rdf:nodeID="N8ddcdcd0c46e42ff81011a1bdcbe5054"/>
    <rdfs:subClassOf rdf:nodeID="Ndb454dca2b924e45ab8872a565909b89"/>
    <rdfs:label xml:lang="en">Enteric Septicemia of Catfish (ESC)</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh gan thận mủ ở cá tra</rdfs:label>
    <rdfs:comment xml:lang="vi">Bệnh gan thận mủ do vi khuẩn Edwardsiella ictaluri gây đốm trắng mủ trên gan, thận, lách ở cá tra, cá lăng.</rdfs:comment>
    <dc:source>Giáo trình Bệnh học Thủy sản, ĐH Cần Thơ, 2014; OIE Aquatic Manual.</dc:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Case_005_Conflict_Warning">
    <rdf:type rdf:resource="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase"/>
    <rdfs:label xml:lang="vi">Ca chẩn đoán 005 - Cảnh báo mâu thuẫn AI và Triệu chứng lâm sàng</rdfs:label>
    <hasAIPrediction rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish"/>
    <suspectedDisease rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Healthy_Fish"/>
    <observedSymptom rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Skin_Ulcers_Inst"/>
    <confidenceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.684</confidenceScore>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#AntisepticDisinfection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <rdfs:label xml:lang="en">Antiseptic Disinfection</rdfs:label>
    <rdfs:label xml:lang="vi">Sát trùng nguồn nước</rdfs:label>
    <rdfs:comment xml:lang="vi">Tạt sát trùng bằng Iodine 90 (0.3-0.5 ppm) hoặc BKC 80% (0.5-0.8 ppm).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Abdominal_Distension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">Abdominal Distension</rdfs:label>
    <rdfs:label xml:lang="vi">Chướng bụng, sưng hậu môn</rdfs:label>
    <rdfs:comment xml:lang="vi">Bụng trướng to chứa dịch vàng hoặc hồng, hậu môn lồi đỏ.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#BacterialDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
    <rdfs:label xml:lang="en">Bacterial Disease</rdfs:label>
    <rdfs:label xml:lang="vi">Bệnh do vi khuẩn</rdfs:label>
    <rdfs:comment xml:lang="vi">Các bệnh truyền nhiễm do vi khuẩn gây ra (Aeromonas, Flavobacterium, Edwardsiella...).</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FungalDisease"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#ParasiticDisease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#NutritionalImmunitySupport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
    <rdfs:label xml:lang="en">Nutritional and Immune Support</rdfs:label>
    <rdfs:label xml:lang="vi">Hỗ trợ dinh dưỡng và miễn dịch</rdfs:label>
    <rdfs:comment xml:lang="vi">Bổ sung Vitamin C (100-200 mg/kg), Beta-glucan và men vi sinh đường ruột.</rdfs:comment>
  </rdf:Description>
