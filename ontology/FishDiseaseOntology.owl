  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Fin_Rot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <rdfs:label xml:lang="en">Fin Rot and Erosion</rdfs:label>
    <rdfs:label xml:lang="vi">Thối vây, mòn vây</rdfs:label>
    <rdfs:comment xml:lang="vi">Các tia vây bị rách nát, cụt dần do vi khuẩn xâm lấn.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#DiagnosticCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Diagnostic Case</rdfs:label>
    <rdfs:label xml:lang="vi">Ca chẩn đoán lâm sàng</rdfs:label>
    <rdfs:comment xml:lang="vi">Biểu diễn một ca chẩn đoán thực tế tại một ao nuôi/mẫu cá cụ thể. Một instance của DiagnosticCase lưu vết các bằng chứng từ ảnh chụp (mô hình AI dự đoán), triệu chứng quan sát tại chỗ, và đo đạc chất lượng nước để đưa vào bộ suy luận tri thức.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishSpecies"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Symptom"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Pathogen"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#WaterCondition"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Treatment"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Prevention"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Prevention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Prevention</rdfs:label>
    <rdfs:label xml:lang="vi">Biện pháp phòng bệnh tổng hợp</rdfs:label>
    <rdfs:comment xml:lang="vi">Các quy trình an toàn sinh học và quản lý môi trường theo quy chuẩn QCVN 02-19:2014/BNNPTNT.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb1432899590046b4b219bce019ce729b">
