    <rdfs:label xml:lang="vi">Tắm thuốc tím KMnO4</rdfs:label>
    <rdfs:comment xml:lang="vi">Tắm thuốc tím 2-4 ppm trong 30-45 phút sát trùng ngoại sinh vật.</rdfs:comment>
  </rdf:Description>
