  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#HealthyState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fish-disease-ontology#FishCondition"/>
    <rdfs:label xml:lang="en">Healthy State</rdfs:label>
    <rdfs:label xml:lang="vi">Trạng thái khỏe mạnh</rdfs:label>
    <rdfs:comment xml:lang="vi">Trạng thái cá hoàn toàn bình thường, phản xạ tốt, không có dấu hiệu bệnh lý.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/fish-disease-ontology#Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#Salt_Bath_2Percent">
