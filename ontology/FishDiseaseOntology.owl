    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">45.0</xsd:maxInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/fish-disease-ontology#hasTreatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
